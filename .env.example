# Gmail account the contact form sends from (usually the same address as CONTACT_EMAIL in lib/constants.ts)
CONTACT_EMAIL_USER=you@gmail.com

# Gmail App Password (NOT your normal Gmail password) - generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification to be enabled)
CONTACT_EMAIL_PASSWORD=

# Optional: override where messages are delivered (defaults to CONTACT_EMAIL in lib/constants.ts)
# CONTACT_EMAIL_TO=

# Optional: only needed if sending through a non-Gmail SMTP provider instead
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
