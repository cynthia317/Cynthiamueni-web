# Copy this file to .env.local and fill in real values for local development.
# .env.local is already git-ignored (see .gitignore) — never commit real secrets.

# Brevo Transactional Email API key (Brevo dashboard -> SMTP & API -> API Keys).
# Server-only — never expose this with a NEXT_PUBLIC_ prefix.
BREVO_API_KEY=your_brevo_api_key

# Private destination inbox for contact-form submissions. Server-only, never displayed
# publicly on the site.
CONTACT_TO_EMAIL=your_destination_email

# Sender address for outgoing contact-form emails. Must be a verified sender/domain in
# Brevo before it will send successfully. Falls back to the public CONTACT_EMAIL constant
# in lib/constants.ts if unset.
CONTACT_FROM_EMAIL=your_verified_sender
