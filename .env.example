# --- Contact form email delivery ---
# The contact form sends via SMTP (Nodemailer). Sender identity (EMAIL_FROM) and delivery
# inbox (EMAIL_TO) are independent of which account authenticates the send.

# The mailbox that actually authenticates and sends the message. Defaults to Gmail's SMTP
# service unless SMTP_HOST is set below.
CONTACT_EMAIL_USER=you@gmail.com

# App password for CONTACT_EMAIL_USER (NEVER your normal account password). For Gmail,
# generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
CONTACT_EMAIL_PASSWORD=

# Optional: only needed if sending through a non-Gmail SMTP provider instead of Gmail's shortcut
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false

# The professional address shown as "From" to recipients. Left unset by default, in which
# case the form sends as CONTACT_EMAIL_USER (guaranteed to work, since that's the account
# that's actually authenticated). Only set this to hello@cynthiamueni.com once that address
# is added as a verified sending alias on the CONTACT_EMAIL_USER account:
#   Gmail -> Settings > Accounts and Import > "Send mail as" > Add another email address
# Setting it before that alias is verified risks Gmail rejecting the send outright, or
# silently rewriting the From — do not set it until the alias is confirmed.
# EMAIL_FROM=hello@cynthiamueni.com

# Where contact-form enquiries are delivered. Defaults to ndukucynthia02@gmail.com.
# EMAIL_TO=ndukucynthia02@gmail.com
