{
  "name": "cynthiamueni-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "baseline:capture": "node tests/baseline/capture.mjs",
    "baseline:check": "node tests/baseline/capture.mjs --check",
    "test:interactive": "node tests/interactive/interactions.mjs",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-paths.mjs prisma/seed/run.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.68.8"
  }
}
